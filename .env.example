# Supabase (Project Settings → API). In locale: `npx supabase status`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Chiave segreta: SOLO server (Vercel env), mai nel browser.
SUPABASE_SECRET_KEY=sb_secret_xxx

# LLM: "gemini" (default) oppure "mock" (storia fissa, nessuna chiamata esterna).
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Protezione free tier: max generazioni complete al giorno su tutto il sito.
DAILY_GENERATION_CAP=20
